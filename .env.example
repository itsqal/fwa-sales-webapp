# The supply-chain API this dashboard proxies to.
#
# Server-side only — it is read by the route handlers in src/app/api and never
# reaches the browser, so it can point at an address only this machine can
# resolve. That is the point: in production the dashboard talks to the API
# without leaving the box.
#
# Development, API running on the host:
API_BASE_URL=http://localhost:8000/v1
#
# Production, both stacks in Docker on the same server. `fwa_sales_api` is the
# API's container name on the shared network:
# API_BASE_URL=http://fwa_sales_api:8000/v1


# Production only. The Docker network the API stack already created, which this
# dashboard joins so it can resolve `fwa_sales_api`. Compose names it after the
# API's project directory. Find the real name with `docker network ls`.
# BACKEND_NETWORK=backend_default
