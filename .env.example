# The supply-chain API this dashboard proxies to.
#
# Server-side only — it is read by the route handlers in src/app/api and never
# reaches the browser, so it can point at an address only this machine can
# resolve. That is the point: on a server that also runs the API, the dashboard
# talks to it over loopback and the traffic never leaves the box.
#
# The API publishes on 127.0.0.1:8000, so this value is the same in development
# and in production.
API_BASE_URL=http://127.0.0.1:8000/v1

# The port the dashboard listens on. nginx proxies to it; it is never exposed
# directly. Defaults to 3000 when unset.
# PORT=3000
